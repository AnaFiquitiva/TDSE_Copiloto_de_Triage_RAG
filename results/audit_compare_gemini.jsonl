{"timestamp_utc": "2026-09-17T21:35:32.571828+00:00", "case_id": "C002", "input_text": "Se cayo de una altura considerable, quedo inconsciente y no ha despertado desde entonces; tiene la piel muy palida.", "corpus_format": "reformatted", "embedding_mode": "clinical_es", "backend": "gemini", "model_version": "minimal-generator-v1", "retrieved_fragments": [{"chunk_id": "ALARMA-TRAUMA-GRAVE", "score": 0.6809, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-TRAUMA-LEVE", "score": 0.6586, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "RES5596-N1", "score": 0.656, "source": "niveles_triage", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-SUICIDA-LEVE", "score": 0.6433, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-SANGRADO-GRAVE", "score": 0.6418, "source": "signos_alarma", "corpus_format": "reformatted"}], "suggested_level": 1, "citation": "ALARMA-TRAUMA-GRAVE", "confidence": 0.6809, "abstained": false, "abstain_reason": null, "human_decision": null}
