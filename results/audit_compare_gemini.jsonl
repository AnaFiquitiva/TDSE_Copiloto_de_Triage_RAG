{"timestamp_utc": "2026-09-17T22:05:46.854326+00:00", "case_id": "C016", "input_text": "Llevo mas de un dia con fiebre muy alta que no baja con nada, me duele todo el cuerpo pero estoy consciente y hablando normal.", "corpus_format": "reformatted", "embedding_mode": "clinical_es", "backend": "gemini", "model_version": "minimal-generator-v1", "retrieved_fragments": [{"chunk_id": "ALARMA-FIEBRE-GRAVE", "score": 0.7165, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-FIEBRE-LEVE", "score": 0.71, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "RES5596-N3", "score": 0.6991, "source": "niveles_triage", "corpus_format": "reformatted"}, {"chunk_id": "RES5596-N4", "score": 0.6643, "source": "niveles_triage", "corpus_format": "reformatted"}, {"chunk_id": "RES5596-N2", "score": 0.6434, "source": "niveles_triage", "corpus_format": "reformatted"}], "suggested_level": 3, "citation": "RES5596-N3", "confidence": 0.6991, "abstained": false, "abstain_reason": null, "human_decision": null}
{"timestamp_utc": "2026-09-17T22:05:49.250382+00:00", "case_id": "C017", "input_text": "Ha tenido vomito y diarrea desde ayer, se ve con la boca seca y un poco decaido, pero todavia responde bien y camina.", "corpus_format": "reformatted", "embedding_mode": "clinical_es", "backend": "gemini", "model_version": "minimal-generator-v1", "retrieved_fragments": [{"chunk_id": "RES5596-N3", "score": 0.6984, "source": "niveles_triage", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-TRAUMA-LEVE", "score": 0.6622, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-FIEBRE-LEVE", "score": 0.6583, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-DIFRESP-LEVE", "score": 0.6579, "source": "signos_alarma", "corpus_format": "reformatted"}, {"chunk_id": "ALARMA-TRAUMA-GRAVE", "score": 0.652, "source": "signos_alarma", "corpus_format": "reformatted"}], "suggested_level": 3, "citation": "RES5596-N3", "confidence": 0.6984, "abstained": false, "abstain_reason": null, "human_decision": null}
